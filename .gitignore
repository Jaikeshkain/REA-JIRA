# dependencies / build output
node_modules/
dist/
*.log

# local dev database (PGlite) — reseeds on start
app/server/data/

# REA capture bundles: large (12 MB) and contain data from the live Jira site (account IDs, emails)
evidence/

# local settings and secrets (templates stay in git)
.env
.env.*
!.env.example

# protected release build output (npm run release)
app/release/

# owner portal secrets on servers (never commit your private key)
app/portal/secrets/
*.pem
