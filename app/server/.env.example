# Tracker API settings. Copy this file to `.env` (same folder) and fill in what you need.
# `.env` is ignored by git — keep real passwords, secrets and connection strings only there.
# Every value is optional; the defaults below are what the app uses when a line is missing or empty.
# Real environment variables always win over this file.

# ---------------------------------------------------------------- URLs and ports
# Public address of the web app, used in email links and the SSO redirect.
APP_URL=http://localhost:5173
# Port the API listens on (127.0.0.1). The Vite dev server proxies /api here.
API_PORT=4000

# ---------------------------------------------------------------- database
# Leave empty to use the embedded PGlite database in server/data/pglite.
# Real PostgreSQL (required for several server instances):
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=
# PGlite data folder (only when DATABASE_URL is empty)
# PGLITE_DIR=
# "1" = don't create the demo site on an empty database
# SKIP_SEED=

# ---------------------------------------------------------------- attachments
# ATTACHMENTS_DIR=
MAX_ATTACHMENT_MB=10

# ---------------------------------------------------------------- email
# Empty = emails stay in the admin outbox (nothing is sent).
#   SMTP_URL=smtp://USER:PASSWORD@smtp.example.com:587
# SMTP_URL=
MAIL_FROM=Tracker <no-reply@tracker.local>
# Hour (UTC) the daily digest goes out
DIGEST_HOUR_UTC=8
# "1" = don't run the background scheduler on this instance
# DISABLE_SCHEDULER=

# ---------------------------------------------------------------- single sign-on (OpenID Connect)
# All three of issuer, client id and client secret are needed to turn SSO on.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Button label on the login page
OIDC_NAME=SSO
# Default: <APP_URL>/api/auth/oidc/callback (register it with your provider)
# OIDC_REDIRECT_URI=
# Comma-separated email domains allowed to sign in with SSO (empty = any)
# OIDC_ALLOWED_DOMAINS=
# "false" = only people who already have an account may sign in with SSO
OIDC_AUTO_CREATE=true
# "1" = password sign-in only for site admins; sign-up closed
# SSO_ONLY=

# ---------------------------------------------------------------- webhooks
# "1" = allow webhooks to private/local addresses (internal receivers). Off by default (SSRF protection).
# WEBHOOK_ALLOW_PRIVATE=
