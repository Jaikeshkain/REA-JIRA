{
  "name": "@tracker/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "test": "tsx src/smoke.test.ts",
    "dev:idp": "tsx src/dev-idp.ts",
    "dev:sso": "tsx watch --env-file-if-exists=.env --env-file=sso-dev.env src/index.ts",
    "test:multi": "tsx --env-file-if-exists=.env src/multi-instance.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
