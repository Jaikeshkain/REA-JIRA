# Copy to .env and fill in. Keep .env private: it holds passwords.

# Image name and version from your Tracker supplier
TRACKER_IMAGE=registry.example.com/tracker:1.0.0

# ---------------------------------------------------------------- database
# Your PostgreSQL (14 or newer). The database must be empty on first start; Tracker creates its tables itself.
DATABASE_URL=postgres://USER:PASSWORD@db.yourcompany.internal:5432/tracker
# Using the bundled PostgreSQL instead (docker compose --profile postgres up -d)? Then use:
#   POSTGRES_PASSWORD=<a long random password>
#   DATABASE_URL=postgres://tracker:<same password>@db:5432/tracker

# ---------------------------------------------------------------- address
# The address people open in their browser (used in email links)
APP_URL=https://tracker.yourcompany.com
# Port on this server. Behind a reverse proxy on the same machine use 127.0.0.1:4000
TRACKER_PORT=4000
# Behind a reverse proxy / load balancer: 1 (so sign-in limits and the audit log see real client addresses)
# TRUST_PROXY=1

# ---------------------------------------------------------------- email (invitations, password resets, notifications)
# Without this, emails wait in Administration → Email outbox instead of being sent.
# SMTP_URL=smtp://USER:PASSWORD@smtp.yourcompany.com:587
# MAIL_FROM=Tracker <tracker@yourcompany.com>

# ---------------------------------------------------------------- licence (optional here)
# Usually installed in Administration → Licence. Setting it here works too.
# LICENSE_KEY=TRK1....

# ---------------------------------------------------------------- single sign-on (optional)
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Microsoft
# SSO_ONLY=1

# Sessions end after this many hours without activity
# SESSION_IDLE_HOURS=12
